<?xml version="1.0" encoding="utf-8"?>
<!-- Nền hình tròn 38dp cho nút quay lại trên header -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#E2E8F0" />
            <stroke
                android:width="1dp"
                android:color="@color/primary" />
            <size
                android:width="38dp"
                android:height="38dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/gray_50" />
            <stroke
                android:width="1dp"
                android:color="@color/card_stroke" />
            <size
                android:width="38dp"
                android:height="38dp" />
        </shape>
    </item>
</selector>
