<?xml version="1.0" encoding="utf-8"?>
<!-- item_product.xml: Giao diện hiển thị một dòng sản phẩm trong danh sách (Icon, Danh mục, Tên, Giá, Mô tả ngắn). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    android:background="@drawable/bg_card_white"
    android:elevation="1dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Khung chứa icon biểu tượng sản phẩm -->
    <FrameLayout
        android:id="@+id/flIconContainer"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_chip_blue">

        <TextView
            android:id="@+id/tvIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textSize="34sp" />
    </FrameLayout>

    <!-- Khối thông tin sản phẩm -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Nhãn danh mục sản phẩm -->
        <TextView
            android:id="@+id/tvCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_blue"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:textColor="@color/primary"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Tên sản phẩm -->
        <TextView
            android:id="@+id/tvName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Giá bán sản phẩm -->
        <TextView
            android:id="@+id/tvPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/danger"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Mô tả ngắn gọn sản phẩm -->
        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:lineSpacingExtra="1dp"
            android:maxLines="2"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Mũi tên chỉ dẫn bấm xem chi tiết -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="›"
        android:textColor="@color/gray_400"
        android:textSize="24sp" />

</LinearLayout>