<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_white"
    android:elevation="2dp"
    android:orientation="vertical"
    tools:context=".ProductListActivity">

    <FrameLayout
        android:id="@+id/flIconContainer"
        android:layout_width="match_parent"
        android:layout_height="136dp"
        android:background="@drawable/bg_chip_blue">

        <TextView
            android:id="@+id/tvIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textSize="54sp"
            tools:text="📱" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_blue"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:textColor="#4F46E5"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="Điện thoại" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvStock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#0D9488"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Còn 38 sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="2"
            android:minLines="2"
            android:textColor="#111827"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="Samsung Galaxy A16 5G 128GB" />

        <!-- Khung trung bình sao màu vàng + đánh giá / đã bán -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAvgStar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="★ 4,8"
                android:textColor="#F59E0B"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvProductReviewSummary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#4B5563"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="(24) · Đã bán 120" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvOriginalPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:paintFlags="strikeThru"
            android:textColor="#9CA3AF"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="5.990.000 ₫"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#EF4444"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="4.792.000 ₫" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/layoutProductVoucherTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_blue"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp"
                android:paddingVertical="3dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:contentDescription="Voucher giảm giá"
                    android:src="@drawable/ic_voucher" />

                <TextView
                    android:id="@+id/tvProductVoucherTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Voucher -20%"
                    android:textColor="#4F46E5"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvProductFreeShipping"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_chip_green"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingHorizontal="6dp"
                android:paddingVertical="3dp"
                android:text="Free ship"
                android:textColor="#0D9488"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>