<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_white"
    android:orientation="vertical"
    android:padding="20dp">
<TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Đổi mật khẩu"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />
<TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:text="Vui lòng nhập mật khẩu hiện tại và mật khẩu mới của bạn."
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />
<TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MẬT KHẨU HIỆN TẠI"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:textStyle="bold" />
<RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="12dp">
        <EditText
            android:id="@+id/edtCurrentPassword"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_input"
            android:drawableStart="@drawable/ic_lock"
            android:drawablePadding="10dp"
            android:hint="Nhập mật khẩu hiện tại"
            android:imeOptions="actionNext"
            android:inputType="textPassword"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="46dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary"
            android:textSize="14sp" />
        <ImageView
            android:id="@+id/btnToggleCurrentPassword"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Ẩn hiện mật khẩu hiện tại"
            android:focusable="true"
            android:padding="12dp"
            android:src="@drawable/ic_visibility_off"
            app:tint="@color/text_secondary" />
    </RelativeLayout>
<TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MẬT KHẨU MỚI (TỐI THIỂU 6 KÝ TỰ)"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:textStyle="bold" />
<RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="12dp">
        <EditText
            android:id="@+id/edtNewPassword"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_input"
            android:drawableStart="@drawable/ic_lock"
            android:drawablePadding="10dp"
            android:hint="Nhập mật khẩu mới"
            android:imeOptions="actionNext"
            android:inputType="textPassword"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="46dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary"
            android:textSize="14sp" />
        <ImageView
            android:id="@+id/btnToggleNewPassword"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Ẩn hiện mật khẩu mới"
            android:focusable="true"
            android:padding="12dp"
            android:src="@drawable/ic_visibility_off"
            app:tint="@color/text_secondary" />
    </RelativeLayout>
<TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="XÁC NHẬN MẬT KHẨU MỚI"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:textStyle="bold" />
<RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="20dp">
        <EditText
            android:id="@+id/edtConfirmNewPassword"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_input"
            android:drawableStart="@drawable/ic_lock"
            android:drawablePadding="10dp"
            android:hint="Nhập lại mật khẩu mới"
            android:imeOptions="actionDone"
            android:inputType="textPassword"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="46dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary"
            android:textSize="14sp" />
        <ImageView
            android:id="@+id/btnToggleConfirmNewPassword"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Ẩn hiện mật khẩu xác nhận"
            android:focusable="true"
            android:padding="12dp"
            android:src="@drawable/ic_visibility_off"
            app:tint="@color/text_secondary" />
    </RelativeLayout>
<LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">
<Button
            android:id="@+id/btnCancelPassword"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_secondary_button"
            android:paddingHorizontal="18dp"
            android:text="HỦY"
            android:textColor="@color/primary"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />
<Button
            android:id="@+id/btnSavePassword"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:background="@drawable/bg_primary_button"
            android:paddingHorizontal="18dp"
            android:text="ĐỔI MẬT KHẨU"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />
    </LinearLayout>
</LinearLayout>
