<?xml version="1.0" encoding="utf-8"?>
<!-- Giao diện hộp thoại khôi phục mật khẩu khi người dùng quên mật khẩu -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_white"
    android:orientation="vertical"
    android:padding="22dp">

    <!-- Tiêu đề hộp thoại -->
    <TextView
        android:id="@+id/tvForgotTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Khôi phục mật khẩu"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Dòng mô tả hướng dẫn -->
    <TextView
        android:id="@+id/tvForgotDesc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:text="Nhập email tài khoản và thiết lập lại mật khẩu mới của bạn."
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- Nhãn email -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ĐỊA CHỈ EMAIL"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- Ô nhập email cần khôi phục -->
    <EditText
        android:id="@+id/edtForgotEmail"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_input"
        android:drawableStart="@drawable/ic_email"
        android:drawablePadding="10dp"
        android:hint="Nhập email tài khoản"
        android:imeOptions="actionNext"
        android:inputType="textEmailAddress"
        android:maxLines="1"
        android:paddingHorizontal="14dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_tertiary"
        android:textSize="14sp" />

    <!-- Nhãn mật khẩu mới -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MẬT KHẨU MỚI (TỐI THIỂU 6 KÝ TỰ)"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- Khung chứa ô nhập mật khẩu mới và nút ẩn/hiện con mắt -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="12dp">

        <!-- Ô nhập mật khẩu mới -->
        <EditText
            android:id="@+id/edtForgotNewPassword"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_input"
            android:drawableStart="@drawable/ic_lock"
            android:drawablePadding="10dp"
            android:hint="Nhập mật khẩu mới"
            android:imeOptions="actionNext"
            android:inputType="textPassword"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="46dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary"
            android:textSize="14sp" />

        <!-- Nút bấm ẩn/hiện mật khẩu mới -->
        <ImageView
            android:id="@+id/btnToggleForgotNewPassword"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Ẩn hiện mật khẩu mới"
            android:focusable="true"
            android:padding="12dp"
            android:src="@drawable/ic_visibility_off"
            app:tint="@color/text_secondary" />
    </RelativeLayout>

    <!-- Nhãn xác nhận mật khẩu mới -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="XÁC NHẬN MẬT KHẨU MỚI"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- Khung chứa ô nhập lại mật khẩu mới và nút ẩn/hiện con mắt -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="18dp">

        <!-- Ô nhập lại mật khẩu mới -->
        <EditText
            android:id="@+id/edtForgotConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_input"
            android:drawableStart="@drawable/ic_lock"
            android:drawablePadding="10dp"
            android:hint="Nhập lại mật khẩu mới"
            android:imeOptions="actionDone"
            android:inputType="textPassword"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="46dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary"
            android:textSize="14sp" />

        <!-- Nút bấm ẩn/hiện mật khẩu xác nhận -->
        <ImageView
            android:id="@+id/btnToggleForgotConfirmPassword"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Ẩn hiện mật khẩu xác nhận"
            android:focusable="true"
            android:padding="12dp"
            android:src="@drawable/ic_visibility_off"
            app:tint="@color/text_secondary" />
    </RelativeLayout>

    <!-- Vòng xoay tải khi đang xử lý đặt lại mật khẩu -->
    <ProgressBar
        android:id="@+id/progressBarForgot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="12dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/primary"
        android:visibility="gone" />

    <!-- Cụm nút bấm Hủy và Đặt lại mật khẩu -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <!-- Nút Hủy bỏ -->
        <Button
            android:id="@+id/btnCancelForgot"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:background="@drawable/bg_secondary_button"
            android:paddingHorizontal="16dp"
            android:text="HỦY"
            android:textColor="@color/primary"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <!-- Nút Xác nhận đặt lại mật khẩu -->
        <Button
            android:id="@+id/btnSubmitForgot"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_primary_button"
            android:paddingHorizontal="16dp"
            android:text="ĐẶT LẠI MẬT KHẨU"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />
    </LinearLayout>

</LinearLayout>
