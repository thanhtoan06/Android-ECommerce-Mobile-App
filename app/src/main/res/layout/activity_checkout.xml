<?xml version="1.0" encoding="utf-8"?>
<!-- Giao diện màn hình thanh toán và nhập thông tin nhận hàng -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    tools:context=".CheckoutActivity">

    <!-- Thanh tiêu đề phía trên cùng -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentTop="true"
        android:background="@color/surface"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <!-- Nút quay lại hình tròn tối giản 38dp x 38dp dùng biểu tượng mũi tên vector màu chủ đạo #4F46E5 -->
        <TextView
            android:id="@+id/tvCheckoutBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_circle_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:padding="9dp"
            app:drawableStartCompat="@drawable/ic_arrow_back"
            app:drawableTint="@color/primary" />

        <!-- Tiêu đề màn hình căn giữa -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Xác nhận thanh toán"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Khoảng trống cân đối căn giữa tiêu đề -->
        <View
            android:layout_width="38dp"
            android:layout_height="38dp" />
    </LinearLayout>

    <!-- Thanh nút xác nhận đặt hàng cố định phía dưới cùng -->
    <LinearLayout
        android:id="@+id/bottomCheckoutBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/surface"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Nút xác nhận tạo đơn hàng -->
        <Button
            android:id="@+id/btnConfirmOrder"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_primary_button"
            android:text="XÁC NHẬN ĐẶT HÀNG"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />
    </LinearLayout>

    <!-- Nội dung thanh toán cuộn dọc -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomCheckoutBar"
        android:layout_below="@id/topBar"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Khối 1: Thông tin giao hàng -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="Giao hàng"
                    android:src="@drawable/ic_location"
                    app:tint="@color/primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="THÔNG TIN GIAO HÀNG"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Thẻ nhập thông tin người nhận -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- Nhãn họ tên người nhận -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Họ và tên người nhận *"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Ô nhập họ tên người nhận -->
                <EditText
                    android:id="@+id/etReceiverName"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_input"
                    android:hint="Nhập họ và tên đầy đủ"
                    android:inputType="textPersonName"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_tertiary"
                    android:textSize="13sp" />

                <!-- Nhãn số điện thoại -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Số điện thoại nhận hàng *"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Ô nhập số điện thoại nhận hàng -->
                <EditText
                    android:id="@+id/etReceiverPhone"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_input"
                    android:hint="Ví dụ: 0912345678"
                    android:inputType="phone"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_tertiary"
                    android:textSize="13sp" />

                <!-- Nhãn địa chỉ nhận hàng -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Địa chỉ nhận hàng chi tiết *"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Ô nhập địa chỉ giao hàng -->
                <EditText
                    android:id="@+id/etReceiverAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_input"
                    android:gravity="top"
                    android:hint="Số nhà, tên đường, phường/xã, quận/huyện, tỉnh/thành"
                    android:inputType="textPostalAddress|textMultiLine"
                    android:minLines="2"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_tertiary"
                    android:textSize="13sp" />

                <!-- Nhãn ghi chú giao hàng -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Ghi chú cho shipper (Tùy chọn)"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Ô nhập ghi chú đơn hàng -->
                <EditText
                    android:id="@+id/etOrderNote"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_input"
                    android:hint="Ví dụ: Giao giờ hành chính, gọi trước khi giao"
                    android:inputType="text"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_tertiary"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- Khối 2: Danh sách sản phẩm trong đơn -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="Sản phẩm"
                    android:src="@drawable/ic_orders"
                    app:tint="@color/primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="SẢN PHẨM TRONG ĐƠN HÀNG"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Vùng chứa danh sách sản phẩm tóm tắt -->
            <LinearLayout
                android:id="@+id/llOrderItemsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:elevation="1dp"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp">

                <!-- Dòng sản phẩm xem trước mẫu cho trình thiết kế (ẩn khi chạy thật) -->
                <include
                    android:id="@+id/sampleCheckoutItemPreview"
                    layout="@layout/item_checkout_summary"
                    android:visibility="gone"
                    tools:visibility="visible" />

            </LinearLayout>

            <!-- Khối 3: Phương thức thanh toán -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="Thanh toán"
                    android:src="@drawable/ic_payment"
                    app:tint="@color/primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="PHƯƠNG THỨC THANH TOÁN"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Nhóm chọn hình thức thanh toán -->
            <RadioGroup
                android:id="@+id/rgPaymentMethods"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:elevation="1dp"
                android:padding="12dp">

                <!-- Tùy chọn thanh toán tiền mặt COD -->
                <RadioButton
                    android:id="@+id/rbCOD"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:drawablePadding="10dp"
                    android:paddingVertical="8dp"
                    android:text="Thanh toán tiền mặt khi nhận hàng (COD)"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    app:buttonTint="@color/primary"
                    app:drawableStartCompat="@drawable/ic_cash"
                    app:drawableTint="@color/primary" />

                <!-- Đường kẻ phân cách -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="4dp"
                    android:background="@color/card_stroke" />

                <!-- Tùy chọn chuyển khoản ngân hàng -->
                <RadioButton
                    android:id="@+id/rbBankTransfer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="10dp"
                    android:paddingVertical="8dp"
                    android:text="Chuyển khoản ngân hàng (VietQR 24/7)"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    app:buttonTint="@color/primary"
                    app:drawableStartCompat="@drawable/ic_bank"
                    app:drawableTint="@color/primary" />

                <!-- Khung thông tin tài khoản ngân hàng (hiện khi chọn chuyển khoản) -->
                <LinearLayout
                    android:id="@+id/layoutBankInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="28dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/bg_chip_blue"
                    android:orientation="vertical"
                    android:padding="10dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• Ngân hàng: Quân Đội (MB Bank)"
                        android:textColor="@color/primary_dark"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="• Số tài khoản: 888899990001"
                        android:textColor="@color/primary_dark"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="• Tên tài khoản: CỬA HÀNG E-COMMERCE"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Đường kẻ phân cách -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="4dp"
                    android:background="@color/card_stroke" />

                <!-- Tùy chọn ví điện tử -->
                <RadioButton
                    android:id="@+id/rbEWallet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="10dp"
                    android:paddingVertical="8dp"
                    android:text="Ví điện tử MoMo / ZaloPay / VNPay"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    app:buttonTint="@color/primary"
                    app:drawableStartCompat="@drawable/ic_wallet"
                    app:drawableTint="@color/primary" />

            </RadioGroup>

            <!-- Khối 4: Tổng kết chi phí -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="Tổng kết"
                    android:src="@drawable/ic_receipt"
                    app:tint="@color/primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="TỔNG KẾT CHI PHÍ"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Thẻ chi tiết tiền hàng, phí ship và tổng thanh toán -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- Dòng tạm tính tiền hàng -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tổng tiền hàng"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <!-- Hiển thị tổng tiền hàng -->
                    <TextView
                        android:id="@+id/tvCheckoutItemsSubtotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 ₫"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Dòng phí vận chuyển -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Phí vận chuyển toàn quốc"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <!-- Hiển thị trạng thái phí vận chuyển -->
                    <TextView
                        android:id="@+id/tvCheckoutShippingFee"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_green"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:text="Miễn phí"
                        android:textColor="@color/success_dark"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Đường kẻ phân cách -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="10dp"
                    android:background="@color/card_stroke" />

                <!-- Dòng tổng cộng thanh toán -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tổng thanh toán:"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <!-- Hiển thị tổng số tiền cuối cùng -->
                    <TextView
                        android:id="@+id/tvCheckoutGrandTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 ₫"
                        android:textColor="@color/danger"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

            <!-- Khoảng đệm dưới cùng -->
            <View
                android:layout_width="match_parent"
                android:layout_height="20dp" />

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
