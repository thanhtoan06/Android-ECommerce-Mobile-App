<?xml version="1.0" encoding="utf-8"?>
<!-- Giao diện hộp thoại thay đổi số điện thoại tài khoản -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_white"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Tiêu đề hộp thoại -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cập nhật số điện thoại"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Dòng mô tả hướng dẫn -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:text="Số điện thoại dùng để nhận hàng và liên hệ khi giao hàng."
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- Nhãn ô nhập số điện thoại -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SỐ ĐIỆN THOẠI MỚI"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- Ô nhập số điện thoại mới kèm icon vector điện thoại phía trước -->
    <EditText
        android:id="@+id/edtNewPhone"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_input"
        android:drawableStart="@drawable/ic_phone"
        android:drawablePadding="10dp"
        android:hint="Ví dụ: 0912345678"
        android:imeOptions="actionDone"
        android:inputType="phone"
        android:maxLines="1"
        android:paddingHorizontal="14dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_tertiary"
        android:textSize="14sp" />

    <!-- Cụm nút thao tác (Hủy và Lưu) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <!-- Nút hủy bỏ và đóng hộp thoại -->
        <Button
            android:id="@+id/btnCancelPhone"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_secondary_button"
            android:paddingHorizontal="18dp"
            android:text="HỦY"
            android:textColor="@color/primary"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <!-- Nút lưu số điện thoại mới lên Firestore -->
        <Button
            android:id="@+id/btnSavePhone"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:background="@drawable/bg_primary_button"
            android:paddingHorizontal="18dp"
            android:text="LƯU THAY ĐỔI"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />
    </LinearLayout>

</LinearLayout>