<?xml version="1.0" encoding="utf-8"?>
<!-- Giao diện màn hình quản lý thông tin tài khoản cá nhân phẳng tối giản -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:orientation="vertical"
    tools:context=".AccountActivity">

    <!-- Phần đầu trang (Header & Khung hồ sơ) đồng bộ màu chủ đạo #4F46E5 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        android:elevation="4dp"
        android:orientation="vertical">

        <!-- Thanh tiêu đề căn giữa cân đối trên nền tím chàm -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <!-- Tiêu đề màn hình màu trắng căn giữa -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tài khoản cá nhân"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Khung hồ sơ người dùng (Avatar tròn vector, Tên, Email) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="20dp">

            <!-- Khung ảnh đại diện tròn nổi bật trên nền tím -->
            <FrameLayout
                android:layout_width="74dp"
                android:layout_height="74dp"
                android:background="@drawable/bg_avatar_circle"
                android:elevation="2dp"
                android:padding="15dp">

                <!-- Biểu tượng avatar vector người dùng chuẩn màu chủ đạo -->
                <ImageView
                    android:id="@+id/ivAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Ảnh đại diện"
                    android:src="@drawable/ic_person"
                    app:tint="@color/primary" />

                <!-- Thẻ TextView ẩn giữ tương thích với ID cũ trong Java -->
                <TextView
                    android:id="@+id/tvAvatar"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Tên người dùng hiển thị chữ trắng nổi bật -->
            <TextView
                android:id="@+id/tvAccountName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Người dùng"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Email tài khoản màu trắng mờ thanh lịch -->
            <TextView
                android:id="@+id/tvAccountEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="user@example.com"
                android:textColor="#E0E7FF"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Phần nội dung cuộn chính -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingTop="14dp"
            android:paddingBottom="16dp">

            <!-- Tiêu đề nhóm thông tin cá nhân -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_marginBottom="8dp"
                android:text="THÔNG TIN CÁ NHÂN"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Thẻ chứa các dòng thông tin cá nhân trực tiếp (bấm để sửa) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:elevation="1dp"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="4dp">

                <!-- Dòng tên tài khoản (bấm để sửa trực tiếp) -->
                <LinearLayout
                    android:id="@+id/layoutUsernameRow"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Icon vector người dùng -->
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="Tên tài khoản"
                        android:src="@drawable/ic_person"
                        app:tint="@color/primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Tên tài khoản"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <!-- Giá trị tên tài khoản -->
                    <TextView
                        android:id="@+id/tvDetailUsername"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="end"
                        android:singleLine="true"
                        android:text="username"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Biểu tượng mũi tên vector chỉ dẫn bấm để sửa -->
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="8dp"
                        android:contentDescription="Sửa tên"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/gray_400" />
                </LinearLayout>

                <!-- Đường kẻ phân cách -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/card_stroke" />

                <!-- Dòng email liên kết (chỉ hiển thị cố định, KHÔNG có mũi tên) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Icon vector email -->
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="Email liên kết"
                        android:src="@drawable/ic_email"
                        app:tint="@color/primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Email liên kết"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <!-- Giá trị email liên kết -->
                    <TextView
                        android:id="@+id/tvDetailEmail"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="end"
                        android:singleLine="true"
                        android:text="user@gmail.com"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Đường kẻ phân cách -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/card_stroke" />

                <!-- Dòng số điện thoại (bấm để sửa trực tiếp) -->
                <LinearLayout
                    android:id="@+id/layoutPhoneRow"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Icon vector điện thoại -->
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="Số điện thoại"
                        android:src="@drawable/ic_phone"
                        app:tint="@color/primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Số điện thoại"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <!-- Giá trị số điện thoại -->
                    <TextView
                        android:id="@+id/tvDetailPhone"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="end"
                        android:singleLine="true"
                        android:text="Chưa thiết lập"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Biểu tượng mũi tên vector chỉ dẫn bấm để sửa -->
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="8dp"
                        android:contentDescription="Sửa số điện thoại"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/gray_400" />
                </LinearLayout>

                <!-- Đường kẻ phân cách -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/card_stroke" />

                <!-- Dòng địa chỉ nhận hàng (bấm để sửa trực tiếp) -->
                <LinearLayout
                    android:id="@+id/layoutAddressRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="8dp">

                    <!-- Icon vector vị trí -->
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="Địa chỉ nhận hàng"
                        android:src="@drawable/ic_location"
                        app:tint="@color/primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Địa chỉ nhận hàng"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <!-- Giá trị địa chỉ nhận hàng -->
                    <TextView
                        android:id="@+id/tvDetailAddress"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="end"
                        android:maxLines="2"
                        android:text="Chưa thiết lập"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Biểu tượng mũi tên vector chỉ dẫn bấm để sửa -->
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="8dp"
                        android:contentDescription="Sửa địa chỉ"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/gray_400" />
                </LinearLayout>
            </LinearLayout>

            <!-- Tiêu đề nhóm bảo mật -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="BẢO MẬT"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Thẻ chứa chức năng đổi mật khẩu -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:elevation="1dp"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="4dp">

                <!-- Nút đổi mật khẩu -->
                <LinearLayout
                    android:id="@+id/btnChangePassword"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Icon vector ổ khóa -->
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="Đổi mật khẩu"
                        android:src="@drawable/ic_lock"
                        app:tint="@color/primary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="Đổi mật khẩu"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <!-- Mũi tên vector chuyển tiếp -->
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="Mở đổi mật khẩu"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/gray_400" />
                </LinearLayout>
            </LinearLayout>

            <!-- Nút đăng xuất tài khoản phẳng bo góc mềm mại nền đỏ nhạt chữ đỏ đậm -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="14dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="ĐĂNG XUẤT TÀI KHOẢN"
                android:textColor="@color/danger_dark"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@color/danger_soft"
                app:cornerRadius="12dp"
                app:elevation="0dp"
                app:icon="@drawable/ic_logout"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconSize="20dp"
                app:iconTint="@color/danger_dark"
                app:strokeColor="#FECACA"
                app:strokeWidth="1dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Thanh menu điều hướng dưới cùng -->
    <include
        android:id="@+id/bottomMenu"
        layout="@layout/include_bottom_menu" />

</LinearLayout>
