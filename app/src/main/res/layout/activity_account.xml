<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FA"
    android:orientation="vertical"
    tools:context=".AccountActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Header tím phủ rộng tạo chiều sâu -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#4F46E5"
                android:orientation="vertical"
                android:paddingBottom="44dp">

                <!-- Thanh tiêu đề & nút bánh răng Cài đặt -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tài khoản của tôi"
                        android:textColor="@color/white"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/btnSettings"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Cài đặt"
                        android:padding="9dp"
                        android:src="@drawable/ic_settings"
                        app:tint="@color/white" />
                </LinearLayout>

                <!-- Thông tin User -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="6dp">

                    <ImageView
                        android:id="@+id/ivAvatar"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_avatar_circle"
                        android:contentDescription="Ảnh đại diện"
                        android:padding="15dp"
                        android:src="@drawable/ic_person"
                        app:tint="#4F46E5" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvAccountName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/white"
                            android:textSize="19sp"
                            android:textStyle="bold"
                            tools:text="Nguyen Van A" />

                        <TextView
                            android:id="@+id/tvAccountEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="#E0E7FF"
                            android:textSize="13sp"
                            tools:text="demo01@example.com" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Thẻ Đơn hàng nổi đè lên mép dưới Header -->
            <LinearLayout
                android:id="@+id/layoutOrderShortcut"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="-26dp"
                android:background="@drawable/bg_card_white"
                android:clickable="true"
                android:elevation="3dp"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Đơn mua của tôi"
                        android:textColor="#111827"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvOrderWaitingLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Xem tất cả"
                        android:textColor="#4F46E5"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="2dp"
                        android:contentDescription="Xem tất cả đơn hàng"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="#4F46E5" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="#F3F4F6" />

                <!-- Trạng thái đơn hàng -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:paddingTop="2dp">

                    <LinearLayout
                        android:id="@+id/layoutOrderWaiting"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:contentDescription="Chờ xác nhận"
                            android:src="@drawable/ic_orders"
                            app:tint="#4F46E5" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:text="Chờ xác nhận"
                            android:textColor="#374151"
                            android:textSize="11sp" />
                        <TextView
                            android:id="@+id/tvOrderWaitingCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="0 đơn"
                            android:textColor="#4F46E5"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            tools:text="2 đơn" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutOrderShipping"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:contentDescription="Đang giao"
                            android:src="@drawable/ic_bolt"
                            app:tint="#4F46E5" />

                        <TextView
                            android:id="@+id/tvOrderShippingLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:text="Đang giao"
                            android:textColor="#374151"
                            android:textSize="11sp" />
                        <TextView
                            android:id="@+id/tvOrderShippingCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="0 đơn"
                            android:textColor="#4F46E5"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            tools:text="1 đơn" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutOrderDelivered"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:contentDescription="Đã giao"
                            android:src="@drawable/ic_check_circle"
                            app:tint="#4F46E5" />

                        <TextView
                            android:id="@+id/tvOrderDeliveredLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:text="Đã giao"
                            android:textColor="#374151"
                            android:textSize="11sp" />
                        <TextView
                            android:id="@+id/tvOrderDeliveredCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="0 đơn"
                            android:textColor="#4F46E5"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            tools:text="16 đơn" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutOrderReturned"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:contentDescription="Hoàn trả"
                            android:src="@drawable/ic_receipt"
                            app:tint="#4F46E5" />

                        <TextView
                            android:id="@+id/tvOrderReturnedLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:text="Hoàn trả"
                            android:textColor="#374151"
                            android:textSize="11sp" />
                        <TextView
                            android:id="@+id/tvOrderReturnedCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="0 đơn"
                            android:textColor="#4F46E5"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            tools:text="1 đơn" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutOrderCancelled"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:contentDescription="Đã hủy"
                            android:src="@drawable/ic_close"
                            app:tint="#4F46E5" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:text="Đã hủy"
                            android:textColor="#374151"
                            android:textSize="11sp" />
                        <TextView
                            android:id="@+id/tvOrderCancelledCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="0 đơn"
                            android:textColor="#4F46E5"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            tools:text="1 đơn" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Tiêu đề cụm Tiện ích -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"
                android:letterSpacing="0.05"
                android:text="TIỆN ÍCH &amp; QUYỀN LỢI"
                android:textColor="#6B7280"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Thẻ Tiện ích của tôi -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:background="@drawable/bg_card_white"
                android:elevation="2dp"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="4dp">

                <!-- Mục 1: Xu -->
                <LinearLayout
                    android:id="@+id/layoutPointsShortcut"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_avatar_circle"
                        android:backgroundTint="#EEF2FF"
                        android:contentDescription="Xu"
                        android:padding="10dp"
                        android:src="@drawable/ic_coin" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tech Xu &amp; Điểm danh"
                            android:textColor="#111827"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Điểm danh 7 ngày nhận tới 700 Xu"
                            android:textColor="#6B7280"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="Mở Xu"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="#9CA3AF" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="56dp"
                    android:background="#F3F4F6" />

                <!-- Mục 2: Kho voucher -->
                <LinearLayout
                    android:id="@+id/layoutVoucherShortcut"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_avatar_circle"
                        android:backgroundTint="#EEF2FF"
                        android:contentDescription="Kho voucher"
                        android:padding="10dp"
                        android:src="@drawable/ic_voucher" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kho voucher"
                            android:textColor="#111827"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Mã giảm giá sản phẩm &amp; Free Ship"
                            android:textColor="#6B7280"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="Mở kho voucher"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="#9CA3AF" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="56dp"
                    android:background="#F3F4F6" />

                <!-- Mục 3: Đánh giá của tôi -->
                <LinearLayout
                    android:id="@+id/layoutReviewsShortcut"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_avatar_circle"
                        android:backgroundTint="#EEF2FF"
                        android:contentDescription="Đánh giá của tôi"
                        android:padding="10dp"
                        android:src="@drawable/ic_check_circle"
                        app:tint="#4F46E5" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Đánh giá của tôi"
                            android:textColor="#111827"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Đánh giá đơn đã giao nhận ngay 500 Xu"
                            android:textColor="#6B7280"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="Mở đánh giá của tôi"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="#9CA3AF" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/bottomMenu"
        layout="@layout/include_bottom_menu" />
</LinearLayout>