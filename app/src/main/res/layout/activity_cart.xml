<?xml version="1.0" encoding="utf-8"?>
<!-- activity_cart.xml: Giao diện màn hình Giỏ hàng (danh sách món hàng, trạng thái giỏ trống, tổng tiền và nút thanh toán). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:orientation="vertical"
    tools:context=".CartActivity">

    <!-- Thanh tiêu đề phía trên cùng -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/surface"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/tvCartHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Giỏ hàng của tôi"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnClearAllCart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_red"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:text="🗑️ Xóa tất cả"
            android:textColor="@color/danger"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Khu vực nội dung chính (hiển thị giỏ trống hoặc danh sách sản phẩm) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Khối thông báo khi giỏ hàng đang trống -->
        <LinearLayout
            android:id="@+id/layoutEmptyCart"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:background="@drawable/bg_avatar_circle">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="🛒"
                    android:textSize="48sp" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Giỏ hàng của bạn đang trống"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Hãy chọn những sản phẩm ưng ý để thêm vào giỏ hàng ngay nhé!"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnShopNow"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_primary_button"
                android:paddingHorizontal="24dp"
                android:text="🛍️ KHÁM PHÁ SẢN PHẨM"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />
        </LinearLayout>

        <!-- Danh sách sản phẩm trong giỏ hàng -->
        <ListView
            android:id="@+id/lvCartItems"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:paddingHorizontal="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="10dp" />

    </FrameLayout>

    <!-- Thanh tổng tiền và nút tiến hành thanh toán -->
    <LinearLayout
        android:id="@+id/layoutCheckoutBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tổng thanh toán:"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvCartTotalPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="0 ₫"
                android:textColor="@color/danger"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btnCheckout"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:background="@drawable/bg_primary_button"
            android:paddingHorizontal="20dp"
            android:text="THANH TOÁN (0)"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />
    </LinearLayout>

    <!-- Thanh menu điều hướng phía dưới cùng -->
    <include
        android:id="@+id/bottomMenu"
        layout="@layout/include_bottom_menu" />

</LinearLayout>