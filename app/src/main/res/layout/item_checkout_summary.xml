<?xml version="1.0" encoding="utf-8"?>
<!-- Giao diện một dòng thông tin trong phần tóm tắt thanh toán -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="8dp">

    <!-- Biểu tượng minh họa sản phẩm -->
    <TextView
        android:id="@+id/tvSummaryIcon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_chip_blue"
        android:gravity="center"
        android:text="📦"
        android:textSize="22sp" />

    <!-- Cụm hiển thị tên và số lượng sản phẩm -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Tên sản phẩm -->
        <TextView
            android:id="@+id/tvSummaryName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Tên sản phẩm"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Số lượng mua của sản phẩm -->
        <TextView
            android:id="@+id/tvSummaryQuantity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:background="@drawable/bg_counter_btn"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="Số lượng: x1"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Thành tiền của dòng sản phẩm này -->
    <TextView
        android:id="@+id/tvSummarySubtotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="189.000 ₫"
        android:textColor="@color/danger"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>