<?xml version="1.0" encoding="utf-8"?>
<!-- Giao diện một dòng thông tin trong phần tóm tắt thanh toán -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="8dp">

    <!-- Biểu tượng vector minh họa sản phẩm màu tím chàm #4F46E5 -->
    <ImageView
        android:id="@+id/ivSummaryIcon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_chip_blue"
        android:contentDescription="Sản phẩm"
        android:padding="10dp"
        android:src="@drawable/ic_orders"
        app:tint="@color/primary" />

    <!-- Cụm hiển thị tên và số lượng sản phẩm -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Tên sản phẩm -->
        <TextView
            android:id="@+id/tvSummaryName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Tên sản phẩm" />

        <!-- Số lượng mua của sản phẩm -->
        <TextView
            android:id="@+id/tvSummaryQuantity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:background="@drawable/bg_counter_btn"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            tools:text="Số lượng: x1" />
    </LinearLayout>

    <!-- Thành tiền của dòng sản phẩm này -->
    <TextView
        android:id="@+id/tvSummarySubtotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="@color/danger"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="189.000 ₫" />

</LinearLayout>
