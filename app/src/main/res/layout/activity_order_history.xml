<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FA"
    android:orientation="vertical"
    tools:context=".OrderHistoryActivity">

    <LinearLayout
        android:id="@+id/topBar"
        style="@style/AppToolbar">

        <ImageView
            android:id="@+id/tvBack"
            style="@style/AppToolbarBackButton"
            android:visibility="visible"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Lịch sử đơn mua"
            style="@style/AppToolbarTitle" />

        <TextView
            android:id="@+id/tvOrderCountBadge"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_toolbar_action"
            android:gravity="center"
            android:minWidth="52dp"
            android:paddingHorizontal="10dp"
            android:text="0 đơn"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="3 đơn" />
    </LinearLayout>

    <!-- Cụm lọc trạng thái đơn gọn gàng -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="1dp"
        android:orientation="vertical">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:fillViewport="false"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp">

                <TextView
                    android:id="@+id/filterOrdersAll"
                    style="@style/OrderFilterChip"
                    android:layout_marginEnd="6dp"
                    android:text="Tất cả" />

                <TextView
                    android:id="@+id/filterOrdersWaiting"
                    style="@style/OrderFilterChip"
                    android:layout_marginEnd="6dp"
                    android:text="Chờ xác nhận" />

                <TextView
                    android:id="@+id/filterOrdersShipping"
                    style="@style/OrderFilterChip"
                    android:layout_marginEnd="6dp"
                    android:text="Đang giao" />

                <TextView
                    android:id="@+id/filterOrdersDelivered"
                    style="@style/OrderFilterChip"
                    android:layout_marginEnd="6dp"
                    android:text="Đã giao" />

                <TextView
                    android:id="@+id/filterOrdersReturned"
                    style="@style/OrderFilterChip"
                    android:layout_marginEnd="6dp"
                    android:text="Hoàn trả" />

                <TextView
                    android:id="@+id/filterOrdersCancelled"
                    style="@style/OrderFilterChip"
                    android:text="Đã hủy" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Trạng thái chưa có đơn hàng -->
        <LinearLayout
            android:id="@+id/layoutEmptyOrders"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:background="@drawable/bg_avatar_circle"
                android:padding="18dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Hộp trống"
                    android:src="@drawable/ic_orders"
                    app:tint="#4F46E5" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvEmptyOrdersTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Chưa có đơn hàng nào"
                android:textColor="#111827"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEmptyOrdersMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="Bạn chưa thực hiện đơn đặt hàng nào trong hệ thống."
                android:textColor="#6B7280"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShopNow"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginTop="20dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="24dp"
                android:text="Mua sắm ngay"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                app:backgroundTint="#4F46E5"
                app:cornerRadius="10dp" />
        </LinearLayout>

        <ListView
            android:id="@+id/lvOrders"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:paddingHorizontal="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp"
            tools:itemCount="3"
            tools:listitem="@layout/item_order" />
    </FrameLayout>

    <include
        android:id="@+id/bottomMenu"
        layout="@layout/include_bottom_menu" />
</LinearLayout>