<?xml version="1.0" encoding="utf-8"?>
<!-- Giao diện màn hình lịch sử đơn hàng của người dùng -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:orientation="vertical"
    tools:context=".OrderHistoryActivity">

    <!-- Thanh tiêu đề phía trên cùng nền màu chủ đạo (#4F46E5) -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/primary"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <!-- Nút quay lại màn hình trước (ẩn đi nhưng giữ lại ID để tương thích mã Java) -->
        <TextView
            android:id="@+id/tvBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <!-- Tiêu đề màn hình căn trái chữ trắng nổi bật (18sp, in đậm) giống màn hình Giỏ hàng -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Lịch sử đơn mua"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Nhãn đếm tổng số đơn hàng nổi bật bên phải -->
        <TextView
            android:id="@+id/tvOrderCountBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tab_active_white"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="0 đơn"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="3 đơn" />
    </LinearLayout>

    <!-- Khung nội dung chính (hiển thị trạng thái trống hoặc danh sách đơn hàng) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Khối thông báo khi chưa có đơn hàng nào -->
        <LinearLayout
            android:id="@+id/layoutEmptyOrders"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <!-- Biểu tượng hộp đơn hàng trống dạng vector chuẩn -->
            <FrameLayout
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:background="@drawable/bg_avatar_circle"
                android:padding="16dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Hộp trống"
                    android:src="@drawable/ic_orders"
                    app:tint="@color/primary" />
            </FrameLayout>

            <!-- Dòng thông báo chính khi chưa có đơn -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Chưa có đơn hàng nào"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Dòng mô tả chi tiết -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Bạn chưa thực hiện đơn đặt hàng nào trong hệ thống."
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <!-- Nút chuyển về trang danh sách sản phẩm -->
            <Button
                android:id="@+id/btnShopNow"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_primary_button"
                android:paddingHorizontal="24dp"
                android:text="MUA SẮM NGAY"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />
        </LinearLayout>

        <!-- Danh sách các đơn hàng đã đặt -->
        <ListView
            android:id="@+id/lvOrders"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:paddingHorizontal="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp"
            tools:listitem="@layout/item_order" />

    </FrameLayout>

    <!-- Thanh menu điều hướng phía dưới cùng 4 mục -->
    <include
        android:id="@+id/bottomMenu"
        layout="@layout/include_bottom_menu" />

</LinearLayout>
