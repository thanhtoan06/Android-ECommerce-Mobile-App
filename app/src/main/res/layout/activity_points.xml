<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FA"
    android:orientation="vertical"
    tools:context=".PointsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="#4F46E5"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:id="@+id/btnBackPoints"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Quay lại"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Tech Xu"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/scrollPoints"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#4F46E5"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="34dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_avatar_circle"
                            android:backgroundTint="#FFFFFF"
                            android:contentDescription="Icon Xu"
                            android:padding="5dp"
                            android:src="@drawable/ic_coin" />

                        <TextView
                            android:id="@+id/tvPointsBalance"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/white"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            tools:text="6.200" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvPointsExpiry"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="#E0E7FF"
                        android:textSize="12sp"
                        tools:text="4.500 Xu sẽ hết hạn ngày 31/12/2026" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginTop="-20dp"
                    android:background="@drawable/bg_card_white"
                    android:elevation="3dp"
                    android:orientation="vertical"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Điểm Danh Nhận Xu"
                        android:textColor="#4F46E5"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/layoutCheckinDays"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <include
                            android:id="@+id/dayCard1"
                            layout="@layout/item_points_day" />

                        <include
                            android:id="@+id/dayCard2"
                            layout="@layout/item_points_day" />

                        <include
                            android:id="@+id/dayCard3"
                            layout="@layout/item_points_day" />

                        <include
                            android:id="@+id/dayCard4"
                            layout="@layout/item_points_day" />

                        <include
                            android:id="@+id/dayCard5"
                            layout="@layout/item_points_day" />

                        <include
                            android:id="@+id/dayCard6"
                            layout="@layout/item_points_day" />

                        <LinearLayout
                            android:id="@+id/dayCard7"
                            android:layout_width="0dp"
                            android:layout_height="84dp"
                            android:layout_weight="1.15"
                            android:background="@drawable/bg_card_white"
                            android:backgroundTint="#EEF2FF"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingHorizontal="2dp"
                            android:paddingVertical="5dp">

                            <TextView
                                android:id="@+id/tvDayReward"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="#4F46E5"
                                android:paddingHorizontal="5dp"
                                android:paddingVertical="2dp"
                                android:textColor="@color/white"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                tools:text="+700" />

                            <ImageView
                                android:id="@+id/ivDayStatus"
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:layout_marginTop="4dp"
                                android:contentDescription="Phần thưởng Ngày 7"
                                android:src="@drawable/ic_coin" />

                            <TextView
                                android:id="@+id/tvDayTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="N7"
                                android:textColor="#4F46E5"
                                android:textSize="9sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvCheckinStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:textColor="#374151"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="Hôm nay: Ngày 1 · Nhận 100 Xu" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCheckin"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="10dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Điểm danh nhận 100 Xu"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:backgroundTint="#4F46E5"
                        app:cornerRadius="12dp"
                        app:elevation="0dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/sectionPointHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_card_white"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="Lịch sử Xu"
                        android:textColor="#111827"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvEmptyHistory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingVertical="24dp"
                        android:text="Chưa có giao dịch Xu"
                        android:textColor="#6B7280"
                        android:textSize="13sp"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <LinearLayout
                        android:id="@+id/layoutPointHistory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        tools:listitem="@layout/item_points_transaction" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <ProgressBar
            android:id="@+id/progressPoints"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="#4F46E5"
            android:visibility="gone" />
    </FrameLayout>

    <include
        android:id="@+id/bottomMenu"
        layout="@layout/include_bottom_menu" />
</LinearLayout>