<?xml version="1.0" encoding="utf-8"?>
<!-- Thành phần menu điều hướng ở phía dưới các màn hình -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="@color/surface"
    android:elevation="8dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <!-- Nút điều hướng 1: Mở trang danh sách sản phẩm -->
    <LinearLayout
        android:id="@+id/menuHome"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingVertical="4dp">

        <!-- Biểu tượng trang chủ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⌂"
            android:textColor="@color/primary"
            android:textSize="22sp" />

        <!-- Nhãn trang sản phẩm -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Sản phẩm"
            android:textColor="@color/primary"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Vạch ngăn cách dọc -->
    <View
        android:layout_width="1dp"
        android:layout_height="28dp"
        android:background="@color/divider" />

    <!-- Nút điều hướng 2: Mở trang giỏ hàng -->
    <LinearLayout
        android:id="@+id/menuCart"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingVertical="4dp">

        <!-- Biểu tượng giỏ hàng -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛒"
            android:textSize="18sp" />

        <!-- Nhãn giỏ hàng -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Giỏ hàng"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Vạch ngăn cách dọc -->
    <View
        android:layout_width="1dp"
        android:layout_height="28dp"
        android:background="@color/divider" />

    <!-- Nút điều hướng 3: Mở trang tài khoản cá nhân -->
    <LinearLayout
        android:id="@+id/menuAccount"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingVertical="4dp">

        <!-- Biểu tượng tài khoản -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👤"
            android:textSize="18sp" />

        <!-- Nhãn tài khoản -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Tài khoản"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>