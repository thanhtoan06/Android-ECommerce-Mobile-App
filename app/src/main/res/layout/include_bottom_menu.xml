<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="@color/surface"
    android:elevation="8dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    tools:context=".ProductListActivity">
<LinearLayout
        android:id="@+id/menuHome"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingVertical="4dp">
        <ImageView
            android:id="@+id/ivMenuHome"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="Trang sản phẩm"
            android:src="@drawable/ic_home"
            app:tint="@color/primary" />
        <TextView
            android:id="@+id/tvMenuHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Sản phẩm"
            android:textColor="@color/primary"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
<View
        android:layout_width="1dp"
        android:layout_height="24dp"
        android:background="@color/divider" />
<LinearLayout
        android:id="@+id/menuCart"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingVertical="4dp">
        <ImageView
            android:id="@+id/ivMenuCart"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="Giỏ hàng"
            android:src="@drawable/ic_cart"
            app:tint="@color/text_secondary" />
        <TextView
            android:id="@+id/tvMenuCart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Giỏ hàng"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>
<View
        android:layout_width="1dp"
        android:layout_height="24dp"
        android:background="@color/divider" />
<LinearLayout
        android:id="@+id/menuNotifications"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingVertical="4dp">
        <ImageView
            android:id="@+id/ivMenuNotifications"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="Thông báo"
            android:src="@drawable/ic_notifications"
            app:tint="@color/text_secondary" />
        <TextView
            android:id="@+id/tvMenuNotifications"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Thông báo"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />
    </LinearLayout>
<View
        android:layout_width="1dp"
        android:layout_height="24dp"
        android:background="@color/divider" />
<LinearLayout
        android:id="@+id/menuAccount"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingVertical="4dp">
        <ImageView
            android:id="@+id/ivMenuAccount"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="Tài khoản"
            android:src="@drawable/ic_person"
            app:tint="@color/text_secondary" />
        <TextView
            android:id="@+id/tvMenuAccount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Tôi"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
