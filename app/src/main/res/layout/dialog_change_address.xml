<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_white"
    android:orientation="vertical"
    android:padding="20dp"
    tools:context=".AccountActivity">
<TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cập nhật địa chỉ nhận hàng"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />
<TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:text="Địa chỉ chi tiết để tự động điền khi thanh toán và giao hàng."
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />
<TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ĐỊA CHỈ GIAO HÀNG MỚI"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:textStyle="bold" />
<EditText
        android:id="@+id/edtNewAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_input"
        android:drawableStart="@drawable/ic_location"
        android:drawablePadding="10dp"
        android:hint="Nhập địa chỉ giao hàng của bạn"
        android:imeOptions="actionDone"
        android:inputType="textMultiLine|textCapSentences"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_tertiary"
        android:textSize="14sp"
        tools:text="123 Nguyễn Huệ, Phường Bến Nghé, Quận 1, TP.HCM" />
<LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">
<Button
            android:id="@+id/btnCancelAddress"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_secondary_button"
            android:paddingHorizontal="18dp"
            android:text="HỦY"
            android:textColor="@color/primary"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />
<Button
            android:id="@+id/btnSaveAddress"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:background="@drawable/bg_primary_button"
            android:paddingHorizontal="18dp"
            android:text="LƯU THAY ĐỔI"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />
    </LinearLayout>
</LinearLayout>
