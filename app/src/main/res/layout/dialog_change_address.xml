<?xml version="1.0" encoding="utf-8"?>
<!-- Giao diện hộp thoại thay đổi địa chỉ nhận hàng -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_white"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Tiêu đề hộp thoại -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cập nhật địa chỉ nhận hàng"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Dòng mô tả hướng dẫn -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:text="Địa chỉ chi tiết để tự động điền khi thanh toán và giao hàng."
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- Nhãn ô nhập địa chỉ -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ĐỊA CHỈ GIAO HÀNG MỚI"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- Ô nhập địa chỉ giao hàng mới -->
    <EditText
        android:id="@+id/edtNewAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_input"
        android:hint="Ví dụ: 123 Đường Nguyễn Trãi, Quận 1, TP. HCM"
        android:inputType="textMultiLine|textCapSentences"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_tertiary"
        android:textSize="14sp" />

    <!-- Cụm nút thao tác (Hủy và Lưu) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <!-- Nút hủy bỏ và đóng hộp thoại -->
        <Button
            android:id="@+id/btnCancelAddress"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_secondary_button"
            android:paddingHorizontal="18dp"
            android:text="HỦY"
            android:textColor="@color/primary"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <!-- Nút lưu địa chỉ mới lên Firestore -->
        <Button
            android:id="@+id/btnSaveAddress"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:background="@drawable/bg_primary_button"
            android:paddingHorizontal="18dp"
            android:text="LƯU THAY ĐỔI"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />
    </LinearLayout>

</LinearLayout>