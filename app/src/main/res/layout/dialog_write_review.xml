<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="18dp"
    android:paddingBottom="12dp"
    tools:context=".ReviewActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Chất lượng sản phẩm thế nào?"
        android:textColor="#111827"
        android:textSize="15sp"
        android:textStyle="bold" />

    <RatingBar
        android:id="@+id/ratingReview"
        style="?android:attr/ratingBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:numStars="5"
        android:progressTint="#F59E0B"
        android:rating="5"
        android:secondaryProgressTint="#FDE68A"
        android:stepSize="1" />

    <EditText
        android:id="@+id/etReviewComment"
        android:layout_width="match_parent"
        android:layout_height="116dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_card_white"
        android:gravity="top|start"
        android:hint="Chia sẻ trải nghiệm của bạn về thiết bị..."
        android:inputType="textCapSentences|textMultiLine"
        android:maxLength="2000"
        android:padding="12dp"
        android:textColor="#111827"
        android:textColorHint="#9CA3AF"
        android:textSize="13sp"
        tools:text="Máy chạy mượt, pin dùng ổn định." />

    <CheckBox
        android:id="@+id/cbReviewAnonymous"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:buttonTint="#4F46E5"
        android:text="Đánh giá ẩn danh"
        android:textColor="#111827"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvReviewRewardHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#EEF2FF"
        android:lineSpacingExtra="2dp"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp"
        android:text="Đánh giá hợp lệ lần đầu nhận 500 Xu; chỉnh sửa không nhận thêm Xu."
        android:textColor="#4F46E5"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>