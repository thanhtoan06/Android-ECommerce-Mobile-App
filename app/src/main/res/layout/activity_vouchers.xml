<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FA"
    android:orientation="vertical"
    tools:context=".VoucherActivity">

    <LinearLayout style="@style/AppToolbar">

        <ImageView
            android:id="@+id/btnBackVouchers"
            style="@style/AppToolbarBackButton" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Kho voucher"
            style="@style/AppToolbarTitle" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="14dp"
                android:paddingBottom="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="14dp"
                    android:text="Ưu đãi dành cho bạn"
                    android:textColor="#111827"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="14dp"
                    android:layout_marginTop="3dp"
                    android:text="Lưu voucher phù hợp và áp dụng khi thanh toán."
                    android:textColor="#6B7280"
                    android:textSize="12sp" />

                <!-- Cụm 3 tab gọn hơn, bo góc vừa -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="14dp"
                    android:layout_marginTop="12dp"
                    android:background="#E5E7EB"
                    android:orientation="horizontal"
                    android:padding="3dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTabAvailable"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:text="Có thể lưu"
                        android:textAllCaps="false"
                        android:textColor="#4F46E5"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:backgroundTint="#FFFFFF"
                        app:cornerRadius="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTabSaved"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:text="Của tôi"
                        android:textAllCaps="false"
                        android:textColor="#4B5563"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:backgroundTint="@android:color/transparent"
                        app:cornerRadius="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTabUsed"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:text="Đã dùng"
                        android:textAllCaps="false"
                        android:textColor="#4B5563"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:backgroundTint="@android:color/transparent"
                        app:cornerRadius="8dp" />
                </LinearLayout>

                <!-- 3 nút lọc đặt sát dưới cho liền mạch -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="14dp"
                    android:layout_marginTop="10dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFilterAllVouchers"
                            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_marginEnd="6dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:paddingHorizontal="12dp"
                            android:text="Tất cả"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            app:backgroundTint="#4F46E5"
                            app:cornerRadius="10dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFilterProductVouchers"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_marginEnd="6dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:paddingHorizontal="12dp"
                            android:text="Sản phẩm"
                            android:textAllCaps="false"
                            android:textColor="#374151"
                            android:textSize="11sp"
                            app:backgroundTint="#FFFFFF"
                            app:cornerRadius="10dp"
                            app:strokeColor="#D1D5DB"
                            app:strokeWidth="1dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFilterShippingVouchers"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:paddingHorizontal="12dp"
                            android:text="Vận chuyển"
                            android:textAllCaps="false"
                            android:textColor="#374151"
                            android:textSize="11sp"
                            app:backgroundTint="#FFFFFF"
                            app:cornerRadius="10dp"
                            app:strokeColor="#D1D5DB"
                            app:strokeWidth="1dp" />
                    </LinearLayout>
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/tvVoucherSectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="14dp"
                    android:layout_marginTop="14dp"
                    android:text="Voucher có thể lưu"
                    android:textColor="#111827"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="Voucher có thể lưu (4)" />

                <TextView
                    android:id="@+id/tvVoucherEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="14dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_card_white"
                    android:elevation="1dp"
                    android:gravity="center"
                    android:padding="24dp"
                    android:text="Chưa có voucher trong mục này"
                    android:textColor="#6B7280"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:visibility="gone" />

                <LinearLayout
                    android:id="@+id/layoutVoucherList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="14dp"
                    android:orientation="vertical"
                    tools:listitem="@layout/item_voucher">

                    <include
                        layout="@layout/item_voucher"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <ProgressBar
            android:id="@+id/progressVouchers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="#4F46E5"
            android:visibility="gone" />
    </FrameLayout>

    <include
        android:id="@+id/bottomMenu"
        layout="@layout/include_bottom_menu" />
</LinearLayout>